rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'Admin';
    }

    // Event images: anyone can read (public, served on event pages),
    // only authenticated users can upload images up to 15MB
    match /events/{eventId}/{filename} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Profile photos: public read so avatars can be shown anywhere,
    // only the owning user can write/delete under their own path
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Feedback screenshots: anyone can upload (feedback is anonymous-friendly).
    // Read is open so the uploader can capture the download URL via
    // getDownloadURL(); the URL itself is only stored in admin-only Firestore
    // docs and includes a random UUID path that cannot be guessed. Images
    // only, max 15 MB.
    match /feedback/{feedbackId}/{filename} {
      allow read: if true;
      allow write: if request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}

# Copy to .env.local and fill in real values for local development.
# When MAILGUN_DRY_RUN=true, the function emails are skipped and the payload
# is logged instead. This lets the functions emulator run without any real
# Mailgun credentials (set in CI / dev when iterating on copy or routing).

MAILGUN_DRY_RUN=true

# Required only when MAILGUN_DRY_RUN is unset/false. In production set these
# as secrets instead:
#   firebase functions:secrets:set MAILGUN_API_KEY
#   firebase functions:secrets:set MAILGUN_DOMAIN
#   firebase functions:secrets:set MAILGUN_FROM
#   firebase functions:secrets:set MAILGUN_REPLY_TO

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=The Tribe <admin@mg.thetribe.at>
MAILGUN_REPLY_TO=admin@thetribe.at

# Optional: shared inbox that always receives "Neuer Event-Vorschlag" emails
# on top of the per-admin recipients from the admin_users collection.
# In production set this as a secret instead:
#   firebase functions:secrets:set SUBMITTED_NOTIFICATION_INBOX
SUBMITTED_NOTIFICATION_INBOX=

# Push gate: the critical user flows only (@smoke), Chromium only.
#
# The full Playwright suite is a manual/release step (npm run test:e2e:full).
# Running all of it on every push is what made pushing take hours and pushed
# everyone onto --no-verify.
#
# Start or restart the emulators if they are down or degraded, instead of
# letting the suite grind against a dead backend (or failing the push for
# something a restart fixes). Fails only if they cannot be brought up.
bash scripts/ensure-emulators.sh || exit 1
npm run test:e2e:smoke

# Firebase Development Environment
# Copy to .env.local and fill in your values

# Set to 'true' to use Firebase Local Emulators
VITE_USE_EMULATORS=false

# Dev project config (only needed when VITE_USE_EMULATORS=true)
# These can be the same as prod, emulator just runs locally
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# GA4 measurement ID (G-XXXXXXXXXX). Falls back to the prod ID in src/lib/firebase.js.
# Analytics only loads after cookie consent and never in emulator/dev builds.
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Kill switch for Google Analytics. On by default in production builds;
# set to 'false' to disable without a code change.
VITE_ANALYTICS_ENABLED=true

# Firebase CLI (for export-prod-data script)
FIREBASE_TOKEN=your-cli-token (get via: firebase login:ci)

# Firebase App Check (reCAPTCHA). Without a site key App Check stays off and the
# app behaves as before. The site key is public (not a secret). In production it
# comes from the GitHub variable VITE_RECAPTCHA_SITE_KEY (see deploy workflow).
VITE_RECAPTCHA_SITE_KEY=
# 'enterprise' (default) or 'v3', matching the provider registered in Firebase.
VITE_RECAPTCHA_PROVIDER=enterprise
# Debug token for local development against production only (Firebase console ->
# App Check -> Manage debug tokens). Put it in .env.local, never commit it.
VITE_APPCHECK_DEBUG_TOKEN=

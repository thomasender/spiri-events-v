rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    function isAdminViaFirestore() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isAdminOrEmulatorAdmin() {
      return isAdmin() || isAdminViaFirestore();
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isApproved() {
      return resource.data.status == 'approved';
    }

    match /events/{eventId} {
      allow read: if isApproved() || isOwner() || isAdminOrEmulatorAdmin();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && (request.resource.data.status == 'pending' || isAdminOrEmulatorAdmin());

      allow update, delete: if isOwner() || isAdminOrEmulatorAdmin();
    }

    match /admin_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}

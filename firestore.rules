rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    function isAdminViaFirestore() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isAdminOrEmulatorAdmin() {
      return isAdmin() || isAdminViaFirestore();
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isEventOwner(eventId) {
      return isAuthenticated()
        && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy;
    }

    function isApproved() {
      return resource.data.status == 'approved';
    }

    // Categories are managed by admins and shown on the public calendar.
    // `name` is normalized server-side (trim + 2–40 chars); `color` is a
    // 6-digit hex string. On create the id must match a deterministic slug
    // of the name so admins can't accidentally create duplicates.
    function isValidCategoryName(name) {
      return name is string && name.size() >= 2 && name.size() <= 40;
    }
    function isValidCategoryColor(color) {
      return color is string && color.matches('^#[0-9a-fA-F]{6}$');
    }
    function isValidCategoryOrder(order) {
      return order is int && order >= 0;
    }

    // Region ids (== slugs) of the region registry: the nine Austrian and
    // sixteen German Bundeslaender, the 26 Swiss cantons and the 60 cultural
    // regions of Germany (they hold Landkreise only after the product owner
    // assigned some in Verwaltung -> "Zuordnung").
    // "Österreich" etc. are combined views in the UI, not regions. KEEP IN SYNC
    // with REGION_SLUGS in src/utils/regions.js (guarded by
    // tests/components/regions.spec.ts); generated order, see
    // scripts/build-region-data.mjs.
    function regionIds() {
      return ['vorarlberg', 'tirol', 'salzburg', 'kaernten', 'steiermark',
              'oberoesterreich', 'niederoesterreich', 'wien', 'burgenland',
              'baden-wuerttemberg', 'bayern', 'berlin', 'brandenburg',
              'bremen', 'hamburg', 'hessen', 'mecklenburg-vorpommern',
              'niedersachsen', 'nordrhein-westfalen', 'rheinland-pfalz',
              'saarland', 'sachsen', 'sachsen-anhalt',
              'schleswig-holstein', 'thueringen', 'zuerich', 'bern',
              'luzern', 'uri', 'schwyz', 'obwalden', 'nidwalden', 'glarus',
              'zug', 'freiburg', 'solothurn', 'basel-stadt',
              'basel-landschaft', 'schaffhausen', 'appenzell-ausserrhoden',
              'appenzell-innerrhoden', 'st-gallen', 'graubuenden',
              'aargau', 'thurgau', 'tessin', 'waadt', 'wallis',
              'neuenburg', 'genf', 'jura', 'schwaben-wuerttemberg',
              'kurpfalz', 'suedbaden-markgraeflerland', 'schwarzwald',
              'oberschwaben', 'tauberfranken', 'oberbayern',
              'niederbayern', 'oberpfalz', 'franken',
              'bayerisch-schwaben-allgaeu', 'niederrhein',
              'koeln-bonn-eifel', 'bergisches-land', 'ruhrgebiet',
              'muensterland', 'sauerland-siegerland', 'ostwestfalen-lippe',
              'ostfriesland', 'oldenburger-land-emsland',
              'lueneburger-heide', 'weserbergland', 'region-hannover',
              'braunschweiger-land-harz', 'nordhessen', 'mittelhessen',
              'odenwald-rhoen', 'rhein-main-gebiet', 'rheingau',
              'erzgebirge', 'vogtland', 'leipzig-region',
              'dresden-elbland', 'oberlausitz', 'pfalz', 'rheinhessen',
              'mosel-saar-ruwer', 'eifel-westerwald', 'hunsrueck',
              'thueringer-wald-rennsteig', 'suedthueringen',
              'klassikerregion', 'eichsfeld', 'nordfriesland',
              'dithmarschen', 'schleswig-angeln', 'holstein',
              'prignitz-uckermark', 'havelland-potsdam', 'spreewald',
              'niederlausitz', 'mecklenburg', 'vorpommern', 'altmark',
              'harz-harzvorland', 'anhalt-dessau', 'saale-unstrut',
              'saarlouis-umgebung', 'saarbruecken-warndt',
              'hochwald-bliesgau'];
    }

    function isValidRegionId(id) {
      return id is string && id in regionIds();
    }

    // ── Regions-Moderator:innen ────────────────────────────────────────
    // `admin_users/{uid}` = { role: 'RegionModerator', regionIds: [...] },
    // written only by the Admin SDK (adminSetRegionModerator callable,
    // scripts/promote-admin.mjs). This is a NARROW extra right next to the
    // Super-Admin (`role: 'Admin'`): isAdminOrEmulatorAdmin() is deliberately
    // untouched, so a moderator never passes any of the many admin-only
    // rules below (categories, theme, instagram, donors, helpers, feedback,
    // member_lists, regions, admin_users, audit log, permanent deletes).
    // Token claims are NOT consulted for moderators: the doc is the only
    // source, so revoking (deleting the doc) takes effect immediately.
    function staffDoc() {
      return get(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isRegionModerator() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && staffDoc().data.role == 'RegionModerator'
        && staffDoc().data.regionIds is list;
    }

    function isRegionModeratorFor(regionId) {
      return isValidRegionId(regionId)
        && isRegionModerator()
        && regionId in staffDoc().data.regionIds;
    }

    // Every id in `ids` is one of the moderator's regions (and there is at
    // least one): entries that are also listed in a foreign region stay
    // read-only for her.
    function isRegionModeratorForAll(ids) {
      return ids is list
        && ids.size() > 0
        && ids.hasOnly(regionIds())
        && isRegionModerator()
        && ids.hasOnly(staffDoc().data.regionIds);
    }

    // Moderation region of an event: the stored regionId, or Vorarlberg for
    // events written before regions existed (same fallback as
    // resolveRegionId in src/utils/regions.js). Online events are moderated
    // by the region in their regionId like every other event.
    function eventRegionId(data) {
      return data.get('regionId', 'vorarlberg');
    }

    // The remembered "Wo bist du?" choice of a user (place + radius). Coordinates are those of
    // the place, never an exact device position. Null clears it.
    function isValidPlaceSelection(d) {
      return !('placeSelection' in d)
        || d.placeSelection == null
        || (d.placeSelection is map
            && d.placeSelection.keys().hasOnly(
              ['label', 'lat', 'lon', 'radiusKm', 'regionId', 'source', 'updatedAt'])
            && d.placeSelection.label is string
            && d.placeSelection.label.size() > 0
            && d.placeSelection.label.size() <= 80
            && d.placeSelection.lat is number
            && d.placeSelection.lat >= -90 && d.placeSelection.lat <= 90
            && d.placeSelection.lon is number
            && d.placeSelection.lon >= -180 && d.placeSelection.lon <= 180
            && d.placeSelection.radiusKm is number
            && d.placeSelection.radiusKm >= 1 && d.placeSelection.radiusKm <= 200
            && d.placeSelection.source in ['search', 'device']
            && d.placeSelection.updatedAt is number
            && (d.placeSelection.get('regionId', null) == null
                || isValidRegionId(d.placeSelection.regionId)));
    }

    // Directory listing fields on the profile docs. A profile may only be
    // listed (`listedInDirectory == true`) when it names at least one
    // category; categories/regions are capped so the doc stays small (up to
    // 120 Bezirk/Landkreis names: one profile may list in several regions).
    // `directoryRegionIds` (region ids, next to the Bezirk names in
    // `directoryRegions`) is optional so profiles saved before regions
    // existed stay valid. `request.resource.data` is the merged document,
    // so this also holds for partial updates.
    function isValidDirectoryData(d) {
      return (!('listedInDirectory' in d) || d.listedInDirectory is bool)
        && (!('directoryCategories' in d)
            || (d.directoryCategories is list && d.directoryCategories.size() <= 5))
        && (!('directoryRegions' in d)
            || (d.directoryRegions is list && d.directoryRegions.size() <= 120))
        && (!('directoryRegionIds' in d)
            || (d.directoryRegionIds is list
                && d.directoryRegionIds.size() <= 10
                && d.directoryRegionIds.hasOnly(regionIds())))
        && (!('listedInDirectory' in d)
            || d.listedInDirectory != true
            || ('directoryCategories' in d && d.directoryCategories.size() >= 1));
    }

    match /events/{eventId} {
      // Organizer opt-in for posting on Instagram; absent == no consent.
      function isValidInstagramConsent() {
        return !('instagramConsent' in request.resource.data)
               || request.resource.data.instagramConsent is bool;
      }

      // Region moderators read pending/approved/trashed events of their
      // regions; drafts of other people stay private (owner + Super-Admin).
      allow read: if isApproved() || isOwner() || isAdminOrEmulatorAdmin()
                  || (resource.data.status in ['pending', 'approved', 'trashed']
                      && isRegionModeratorFor(eventRegionId(resource.data)));

      // imageFocalPoint, if present, must be a {x, y} map with both values
      // being numbers in [0, 1]. The form layer treats {0.5, 0.5} as "no
      // focal point set" and omits the field entirely — these rules allow
      // either form. Used by the calendar tile, list row, and modal hero
      // via object-position to keep the chosen region visible after cropping.
      function isValidFocalPoint() {
        // Either the field is absent (no focal point set), explicitly null
        // (form layer reset it because the image was removed/replaced), or
        // a valid {x, y} map with both values in [0, 1]. The form layer
        // emits `null` instead of omitting the field on the second case so
        // re-saving the doc clears any stale focal point from a previous
        // image — treating null as "no focal point" lets those updates
        // pass without forcing the form to use deleteField().
        return !('imageFocalPoint' in request.resource.data)
               || request.resource.data.imageFocalPoint == null
               || (
                 request.resource.data.imageFocalPoint.keys().hasOnly(['x', 'y'])
                 && request.resource.data.imageFocalPoint.x is number
                 && request.resource.data.imageFocalPoint.y is number
                 && request.resource.data.imageFocalPoint.x >= 0
                 && request.resource.data.imageFocalPoint.x <= 1
                 && request.resource.data.imageFocalPoint.y >= 0
                 && request.resource.data.imageFocalPoint.y <= 1
               );
      }

      // imageZoom, if present, is a number in [1, 3] (scale about the focal
      // point) or null when the image was removed/replaced.
      function isValidImageZoom() {
        return !('imageZoom' in request.resource.data)
               || request.resource.data.imageZoom == null
               || (
                 request.resource.data.imageZoom is number
                 && request.resource.data.imageZoom >= 1
                 && request.resource.data.imageZoom <= 3
               );
      }

      // Cancellation ("Abgesagt"): `cancelled` is a bool for the whole event,
      // `cancelledDates` a list of the series' cancelled dates (YYYY-MM-DD).
      function isValidCancellation() {
        let data = request.resource.data;
        return (!('cancelled' in data) || data.cancelled is bool)
               && (!('cancelledDates' in data)
                   || (data.cancelledDates is list
                       && data.cancelledDates.size() <= 400
                       && (data.cancelledDates.size() == 0
                           || (data.cancelledDates[0] is string
                               && data.cancelledDates[data.cancelledDates.size() - 1] is string))));
      }

      // regionId (moderation region, also for online events) is optional:
      // events written before regions existed have none and fall back to
      // Vorarlberg on read. When present it must be a known region id.
      function isValidEventRegionOnCreate() {
        return !('regionId' in request.resource.data)
               || isValidRegionId(request.resource.data.regionId);
      }

      // On update only a changed regionId is checked, so every existing
      // path (status changes, trash/restore, series exceptions, image
      // patches) keeps working on any stored document.
      function isValidEventRegionOnUpdate() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['regionId'])
               || !('regionId' in request.resource.data)
               || isValidRegionId(request.resource.data.regionId);
      }

      // lat / lng: position of the event (Ort / Bezirk accuracy, derived in the browser from
      // the bundled place list for the radius filter). Optional, null when unknown.
      function isValidEventPosition() {
        let d = request.resource.data;
        return (!('lat' in d) || d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
               && (!('lng' in d) || d.lng == null
                   || (d.lng is number && d.lng >= -180 && d.lng <= 180));
      }

      // Anyone creating an event (including admins) must start it as
      // 'pending' or 'draft'. Approval happens via update. Non-admins
      // additionally need a confirmed email address.
      allow create: if (isAdminOrEmulatorAdmin()
                        || (isAuthenticated()
                            && request.auth.token.email_verified == true))
                    && request.resource.data.createdBy == request.auth.uid
                    && (request.resource.data.status in ['pending', 'draft'])
                    && request.resource.data.description.size() <= 20000
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 40))
                    && isValidInstagramConsent()
                    && isValidFocalPoint()
                    && isValidImageZoom()
                    && isValidEventPosition()
                    && isValidEventRegionOnCreate();

      // Moderation guard for owners who are not admins (a direct write
      // bypasses the UI): an owner may keep an ALREADY approved event
      // approved (Instagram-only edits, series exceptions, image patches),
      // but never move an event INTO 'approved' from any other status, and
      // never write the fields only the review flow sets: approval/unpublish
      // bookkeeping, the public slug (changed on approval), ownership, and
      // the admin's trash reason. Owner trash/restore writes trashedBy = own
      // uid / null and trashReason = null (buildTrashUpdate/buildRestoreUpdate).
      function isOwnerUpdateWithoutReview() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return (after.status != 'approved' || before.get('status', null) == 'approved')
          && !changed.hasAny(['approvedBy', 'approvedAt', 'unpublishedBy', 'unpublishedAt',
                              'slug', 'createdBy'])
          && (!changed.hasAny(['trashReason']) || after.get('trashReason', null) == null)
          && (!changed.hasAny(['trashedBy'])
              || after.get('trashedBy', null) == null
              || after.get('trashedBy', null) == request.auth.uid)
          && (after.status != 'approved' || isOwnerApprovedPatch(before, after, changed));
      }

      // While an owner's event stays approved, its reviewed content is frozen.
      // Allowed: Instagram settings (EventForm Instagram-only save, Instagram
      // photo upload), cover image / focal point / zoom patches, and series
      // exceptions (utils/customSeriesUpdates, exceptionDates arrayUnion,
      // recurrenceEndDate cut-off) and cancelling / un-cancelling the event or
      // single dates (cancelled, cancelledDates) without a new review. `customDates` may only shrink, so no new
      // dates are published without review. Any other change has to move the
      // event to draft / pending / trashed first.
      function isOwnerApprovedPatch(before, after, changed) {
        return changed.hasOnly(['instagramConsent', 'instagramHandleOverride', 'instagramImage',
                                'imageUrl', 'imageThumbUrl', 'imageFocalPoint', 'imageZoom',
                                'customDates', 'exceptionDates', 'recurrenceEndDate',
                                'cancelled', 'cancelledDates',
                                'updatedAt'])
          && (!changed.hasAny(['customDates'])
              || (after.customDates is list
                  && before.get('customDates', []) is list
                  && before.get('customDates', []).toSet().hasAll(after.customDates)))
          && (!changed.hasAny(['recurrenceEndDate'])
              || (after.recurrenceEndDate is string
                  && after.recurrenceEndDate != ''
                  && (before.get('recurrenceEndDate', '') in ['', null]
                      || after.recurrenceEndDate <= before.recurrenceEndDate)));
      }

      // Owners and admins can move events to/from the trash (status='trashed'),
      // and the first read rule already lets the owner + admin read trashed
      // events so the Papierkorb tab can list them.
      allow update: if (isAdminOrEmulatorAdmin() || (isOwner() && isOwnerUpdateWithoutReview()))
                    && request.resource.data.description.size() <= 20000
                    && (request.resource.data.status in ['pending', 'draft', 'approved', 'trashed'])
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 40))
                    && isValidInstagramConsent()
                    && isValidFocalPoint()
                    && isValidImageZoom()
                    && isValidEventPosition()
                    && isValidCancellation()
                    && isValidEventRegionOnUpdate();

      // Review actions of a region moderator on a (non-draft) event of one
      // of her regions. Only the status change and its bookkeeping fields
      // may change: no content edits, no regionId change (so no moving an
      // event into another region), no category. Each action mirrors what
      // the admin UI writes:
      //   approve         pending  -> approved (approvedBy/At, maybe slug)
      //   request changes pending  -> draft
      //   unpublish       approved -> draft    (unpublishedBy/At)
      //   reject / trash  pending|approved -> trashed (trashedBy/At/Reason)
      //   restore         trashed  -> draft    (trash fields nulled)
      // Permanent delete stays Super-Admin only (delete rule below).
      function isModeratorReviewUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.diff(before).affectedKeys();
        return before.status in ['pending', 'approved', 'trashed']
          && isRegionModeratorFor(eventRegionId(before))
          && changed.hasAll(['status'])
          && changed.hasOnly(['status', 'updatedAt', 'approvedBy', 'approvedAt', 'slug',
                              'unpublishedBy', 'unpublishedAt',
                              'trashedAt', 'trashedBy', 'trashReason'])
          && (!changed.hasAny(['updatedAt']) || after.updatedAt == request.time)
          // Slug: only the collision variant resolveSlugForApproval makes
          // ("<slug>-N", or for "<...-yyyymmdd>-N" also "<...-yyyymmdd>-M"), so a moderator
          // cannot point an event at an arbitrary (foreign) public URL.
          && (!changed.hasAny(['slug'])
              || (after.status == 'approved'
                  && before.slug is string
                  && before.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
                  && after.slug is string
                  && after.slug.size() <= 200
                  && (after.slug.matches(before.slug + '-[0-9]+')
                      || (before.slug.matches('^.*-[0-9]{8}-[0-9]+$')
                          && after.slug.matches(before.slug.replace('-[0-9]+$', '') + '-[0-9]+')))))
          && (
            (before.status == 'pending' && after.status == 'approved'
              && changed.hasOnly(['status', 'updatedAt', 'approvedBy', 'approvedAt', 'slug'])
              && after.approvedBy == request.auth.uid
              && after.approvedAt == request.time)
            || (before.status == 'pending' && after.status == 'draft'
              && changed.hasOnly(['status', 'updatedAt']))
            || (before.status == 'approved' && after.status == 'draft'
              && changed.hasOnly(['status', 'updatedAt', 'unpublishedBy', 'unpublishedAt'])
              && after.unpublishedBy == request.auth.uid
              && after.unpublishedAt == request.time)
            || (before.status in ['pending', 'approved'] && after.status == 'trashed'
              && changed.hasOnly(['status', 'updatedAt', 'trashedAt', 'trashedBy', 'trashReason'])
              && after.trashedBy == request.auth.uid
              && after.trashedAt == request.time
              && (!('trashReason' in after) || after.trashReason == null
                  || (after.trashReason is string && after.trashReason.size() <= 2000)))
            || (before.status == 'trashed' && after.status == 'draft'
              && changed.hasOnly(['status', 'updatedAt', 'trashedAt', 'trashedBy', 'trashReason'])
              && after.get('trashedAt', null) == null
              && after.get('trashedBy', null) == null
              && after.get('trashReason', null) == null)
          );
      }

      allow update: if isModeratorReviewUpdate();

      allow delete: if isOwner() || isAdminOrEmulatorAdmin();

      match /messages/{messageId} {
        // Region moderators: messages of non-draft events of their regions.
        function isRegionModeratorForEvent() {
          let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
          return ev.status in ['pending', 'approved', 'trashed']
            && isRegionModeratorFor(eventRegionId(ev));
        }

        allow read: if isEventOwner(eventId) || isAdminOrEmulatorAdmin()
                    || isRegionModeratorForEvent();

        // A moderator who is not the event owner writes as staff
        // (authorRole 'Admin'), never in the organizer's name.
        allow create: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin()
                          || (isRegionModeratorForEvent()
                              && request.resource.data.authorRole == 'Admin'))
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(
                        ['text', 'authorUid', 'authorRole', 'authorName', 'createdAt', 'readByRecipient']
                      )
                      && request.resource.data.text.size() > 0
                      // Rich-text HTML: plain-text length (2000) is enforced client-side,
                      // the stored HTML is longer because of tags.
                      && request.resource.data.text.size() <= 20000
                      && request.resource.data.authorRole in ['Admin', 'User'];

        allow update: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin()
                          || isRegionModeratorForEvent())
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readByRecipient']);

        // Authors can edit their own messages at any time. Admins can edit every
        // admin message, whichever admin account wrote it (the role counts, not
        // the owner). They cannot edit a user's messages.
        allow update: if (
                        ((isEventOwner(eventId) || isAdminOrEmulatorAdmin())
                          && resource.data.authorUid == request.auth.uid)
                        || (isAdminOrEmulatorAdmin() && resource.data.authorRole == 'Admin')
                      )
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['text', 'editedAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 20000
                      && request.resource.data.editedAt == request.time;

        // Owners can permanently delete their own event's messages via the
        // Papierkorb. Admins can always delete messages. Region moderators
        // can delete messages of their regions' events because approving an
        // event clears its conversation (approveEventAsAdmin).
        allow delete: if isAdminOrEmulatorAdmin() || isEventOwner(eventId)
                      || isRegionModeratorForEvent();
      }

      // Change history, written only by the onEventUpdatedWriteRevision
      // function (Admin SDK). Admins read it; nobody writes from the client.
      match /revisions/{revisionId} {
        allow read: if isAdminOrEmulatorAdmin();
        allow write: if false;
      }
    }

    // Role docs ({ role: 'Admin' } or { role: 'RegionModerator', regionIds }).
    // Written ONLY via the Admin SDK (adminSetRegionModerator callable,
    // scripts/promote-admin.mjs): no client, not even a Super-Admin, may
    // write here, and a moderator can never touch her own doc.
    match /admin_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
    }

    // Audit trail of role changes (adminSetRegionModerator). Written only by
    // the Admin SDK; readable by Super-Admins only, never by moderators.
    match /admin_audit_log/{entryId} {
      allow read: if isAdminOrEmulatorAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                      ['displayName', 'bio', 'bioHtml', 'website', 'contact', 'photoURL', 'photoFocalPoint', 'photoZoom',
                       'slug', 'username', 'socialMedia',
                       'listedInDirectory', 'directoryCategories', 'directoryRegions', 'directoryRegionIds', 'showOnlineStatus', 'allowMentions',
                       'notifyOnSubmitted', 'notifyOnChangesRequested',
                       'notifyOnPublished', 'notifyOnDeleted',
                       'notifyOnContactMessage', 'notifyOnFavoriteCancelled',
                       'notifyNewsletter', 'instagramConsentDefault', 'onboardingDismissed',
                       'createdAt', 'updatedAt']
                    )
                    && request.resource.data.bio.size() <= 2000
                    && request.resource.data.displayName.size() <= 80
                    && isValidDirectoryData(request.resource.data)
                    && (!('instagramConsentDefault' in request.resource.data)
                        || request.resource.data.instagramConsentDefault is bool)
                    && (!('showOnlineStatus' in request.resource.data)
                        || request.resource.data.showOnlineStatus is bool)
                    && (!('allowMentions' in request.resource.data)
                        || request.resource.data.allowMentions is bool)
                    && (!('onboardingDismissed' in request.resource.data)
                        || request.resource.data.onboardingDismissed is bool)
                    && (!('bioHtml' in request.resource.data)
                        || (request.resource.data.bioHtml is string
                            && request.resource.data.bioHtml.size() <= 20000));

      allow update: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.bio.size() <= 2000
                    && request.resource.data.displayName.size() <= 80
                    && isValidDirectoryData(request.resource.data)
                    && isValidPlaceSelection(request.resource.data)
                    && (!('instagramConsentDefault' in request.resource.data)
                        || request.resource.data.instagramConsentDefault is bool)
                    && (!('showOnlineStatus' in request.resource.data)
                        || request.resource.data.showOnlineStatus is bool)
                    && (!('allowMentions' in request.resource.data)
                        || request.resource.data.allowMentions is bool)
                    && (!('onboardingDismissed' in request.resource.data)
                        || request.resource.data.onboardingDismissed is bool)
                    && (!('bioHtml' in request.resource.data)
                        || (request.resource.data.bioHtml is string
                            && request.resource.data.bioHtml.size() <= 20000))
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'bio', 'bioHtml', 'website', 'contact', 'photoURL', 'photoFocalPoint', 'photoZoom',
                                  'slug', 'username', 'socialMedia',
                                  'listedInDirectory', 'directoryCategories', 'directoryRegions', 'directoryRegionIds', 'showOnlineStatus', 'allowMentions',
                                  'notifyOnSubmitted', 'notifyOnChangesRequested',
                                  'notifyOnPublished', 'notifyOnDeleted',
                                  'notifyOnContactMessage', 'notifyOnFavoriteCancelled',
                                  'notifyNewsletter', 'instagramConsentDefault', 'onboardingDismissed', 'placeSelection',
                                  'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid == uid;

      // Private favorites: one doc per favorited event series (doc id = event id).
      // Owner-only; no update, a favorite is either present or absent.
      match /favorites/{eventId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow create: if isAuthenticated()
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isAuthenticated() && request.auth.uid == uid;
      }

      // "Someone mentioned you" notifications (docs/chat.md). Created only by the
      // Cloud Functions `onLagerfeuerMention` and `onKerzenraumMention` (no client create), so nobody can spam
      // another person's bell. The owner reads, marks as read (only `read`
      // may change, only to true) and deletes.
      match /mentions/{mentionId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
        allow update: if isAuthenticated()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                      && request.resource.data.read == true;
        allow delete: if isAuthenticated() && request.auth.uid == uid;
      }

      // Public profile subdoc: mirrors only the public-safe fields
      // (displayName, bio, website, photoURL, slug) so anyone can render a
      // organizer's public profile page via the `/:slug` route without
      // exposing `contact`, `notifyOn*`, or the user's identity-bound
      // email. Only the owner can write — the client mirrors this from
      // the parent profile doc on save.
      match /publicProfile/{docId} {
        allow read: if true;

        allow create: if isAuthenticated()
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(
                        ['displayName', 'bio', 'bioHtml', 'website', 'photoURL', 'photoFocalPoint', 'photoZoom', 'slug', 'username', 'socialMedia',
                         'listedInDirectory', 'directoryCategories', 'directoryRegions', 'directoryRegionIds', 'showOnlineStatus',
                         'allowMentions', 'mentionName',
                         'updatedAt']
                      )
                      && request.resource.data.bio.size() <= 2000
                      && request.resource.data.displayName.size() <= 80
                      && isValidDirectoryData(request.resource.data)
                      && (!('showOnlineStatus' in request.resource.data)
                          || request.resource.data.showOnlineStatus is bool)
                      && (!('allowMentions' in request.resource.data)
                          || request.resource.data.allowMentions is bool)
                      && (!('mentionName' in request.resource.data)
                          || (request.resource.data.mentionName is string
                              && request.resource.data.mentionName.size() <= 80))
                      && (!('bioHtml' in request.resource.data)
                          || (request.resource.data.bioHtml is string
                              && request.resource.data.bioHtml.size() <= 20000));

        allow update: if isAuthenticated()
                      && request.auth.uid == uid
                      && request.resource.data.bio.size() <= 2000
                      && request.resource.data.displayName.size() <= 80
                      && isValidDirectoryData(request.resource.data)
                      && (!('showOnlineStatus' in request.resource.data)
                          || request.resource.data.showOnlineStatus is bool)
                      && (!('allowMentions' in request.resource.data)
                          || request.resource.data.allowMentions is bool)
                      && (!('mentionName' in request.resource.data)
                          || (request.resource.data.mentionName is string
                              && request.resource.data.mentionName.size() <= 80))
                      && (!('bioHtml' in request.resource.data)
                          || (request.resource.data.bioHtml is string
                              && request.resource.data.bioHtml.size() <= 20000))
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['displayName', 'bio', 'bioHtml', 'website', 'photoURL', 'photoFocalPoint', 'photoZoom', 'slug', 'username', 'socialMedia',
                                    'listedInDirectory', 'directoryCategories', 'directoryRegions', 'directoryRegionIds', 'showOnlineStatus',
                                    'allowMentions', 'mentionName',
                                    'updatedAt']);

        // Moderation: admins can hide a listing from the directory (and
        // undo that) via `directoryHidden`. The owner's allowed-key lists
        // above deliberately exclude it, so a hidden user cannot re-show
        // themselves; the merge-writes from the profile form never touch it.
        allow update: if isAdminOrEmulatorAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['directoryHidden'])
                      && request.resource.data.directoryHidden is bool;

        // Region moderators may hide/unhide a listing only when ALL its
        // regions are hers (profiles saved before regions existed count as
        // Vorarlberg); listings that also appear in a foreign region stay
        // read-only for her. Staff accounts (any admin_users doc) are off
        // limits.
        allow update: if isRegionModeratorForAll(
                           resource.data.get('directoryRegionIds', ['vorarlberg']))
                      && !exists(/databases/$(database)/documents/admin_users/$(uid))
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['directoryHidden'])
                      && request.resource.data.directoryHidden is bool;

        allow delete: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Public-readable collection group rule for `publicProfile`. Used by the
    // `/:slug` organizer page lookup and by slug-uniqueness checks on
    // profile save. Without an explicit top-level match, Firestore rejects
    // collection group queries on a subcollection because the parent
    // `/users/{uid}` rule does not allow `list` (only owner reads). This
    // rule exposes only the `publicProfile` subdoc — the parent user doc
    // and other private fields stay protected by the rules above.
    match /{parentPath=**}/publicProfile/{docId} {
      allow read: if true;
    }

    // Categories registry — admins manage name + color, the calendar reads
    // it publicly to render category chips. Only admins can update/delete.
    // On create there are two paths:
    //   1. Admin-authenticated write (normal CRUD via the admin UI).
    //   2. Anonymous "system seed" — locked to the canonical 7 initial
    //      category names so the app can self-bootstrap the registry on
    //      first run without requiring an admin to be signed in. The
    //      `createdBy == 'system'` flag + locked name list prevents abuse.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if (isAdminOrEmulatorAdmin()
                       && request.resource.data.keys().hasOnly(
                         ['name', 'color', 'order', 'createdAt', 'updatedAt', 'createdBy']
                       )
                       && isValidCategoryName(request.resource.data.name)
                       && isValidCategoryColor(request.resource.data.color)
                       && (!('order' in request.resource.data)
                           || isValidCategoryOrder(request.resource.data.order)))
                     || (request.auth == null
                         && request.resource.data.createdBy == 'system'
                         && request.resource.data.name in [
                           'Yoga',
                           'Breathwork',
                           'Meditation',
                           'Tanz',
                           'Singen',
                           'Soundhealing',
                           'Coaching',
                           'Körperarbeit',
                           'Ernährung',
                           'Therapie',
                           'Sonstiges',
                         ]
                         && request.resource.data.color is string
                         && isValidCategoryColor(request.resource.data.color));
      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'color', 'order', 'updatedAt'])
                    // Only validate the fields the admin actually changed —
                    // `request.resource.data` carries just the changed keys,
                    // not the merged document, so checking `name` on a
                    // reorder-only update would falsely fail.
                    && (!('name' in request.resource.data)
                        || isValidCategoryName(request.resource.data.name))
                    && (!('color' in request.resource.data)
                        || isValidCategoryColor(request.resource.data.color))
                    && (!('order' in request.resource.data)
                        || isValidCategoryOrder(request.resource.data.order));
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Region registry (one doc per region, doc id == slug).
    // Public read, admin-only write, closed field list, slug from the fixed list.
    match /regions/{regionId} {
      // Everything but the slug-in-list check (a moderator's regionId is already
      // validated by isRegionModeratorFor; saves rule expressions, the budget is 1000).
      function isValidRegionFields(d) {
        return d.keys().hasOnly(
                 ['name', 'slug', 'order', 'active', 'bezirke', 'contactEmail', 'seo',
                  'timezone', 'aboutHelperIds', 'aboutHeaderImage', 'aboutText', 'aboutSlogan1',
                  'aboutSlogan2', 'aboutSloganLocked', 'instagramHandle', 'texts', 'createdAt',
                  'updatedAt', 'mappingUpdatedAt'])
          && d.slug is string
          && d.slug == regionId
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && (!('order' in d) || d.order is number)
          && (!('active' in d) || d.active is bool)
          && (!('bezirke' in d) || (d.bezirke is list && d.bezirke.size() <= 250))
          && (!('contactEmail' in d) || (d.contactEmail is string && d.contactEmail.size() <= 200))
          && (!('seo' in d) || d.seo is map)
          && (!('timezone' in d) || d.timezone is string)
          && (!('aboutHelperIds' in d)
              || (d.aboutHelperIds is list && d.aboutHelperIds.size() <= 60))
          && (!('aboutHeaderImage' in d)
              || d.aboutHeaderImage == null
              || (d.aboutHeaderImage is string && d.aboutHeaderImage.size() <= 500
                  && d.aboutHeaderImage.matches('^https?://.+$')))
          && (!('aboutText' in d)
              || d.aboutText == null
              || (d.aboutText is string && d.aboutText.size() <= 20000))
          && (!('aboutSlogan1' in d)
              || d.aboutSlogan1 == null
              || (d.aboutSlogan1 is string && d.aboutSlogan1.size() <= 30))
          && (!('aboutSlogan2' in d)
              || d.aboutSlogan2 == null
              || (d.aboutSlogan2 is string && d.aboutSlogan2.size() <= 30))
          && (!('aboutSloganLocked' in d) || d.aboutSloganLocked is bool)
          && (!('texts' in d) || isValidRegionTexts(d.texts))
          // Display-only Instagram name; only Super-Admins can write it (the
          // moderator rule below keeps its own, shorter field list).
          && (!('instagramHandle' in d)
              || d.instagramHandle == null
              || (d.instagramHandle is string
                  && d.instagramHandle.matches('^@[A-Za-z0-9._]{1,30}$')));
      }
      function isValidRegion(d) {
        return isValidRegionFields(d) && d.slug in regionIds();
      }
      // Free texts of a region: { examples: { place, organizer, address, contact } },
      // plain strings of at most 120 characters (placeholders of the event form).
      function isValidExampleText(v) {
        return v is string && v.size() <= 120;
      }
      function isValidRegionTexts(t) {
        return t is map
          && t.keys().hasOnly(['examples'])
          && (!('examples' in t)
              || (t.examples is map
                  && t.examples.keys().hasOnly(['place', 'organizer', 'address', 'contact'])
                  && (!('place' in t.examples) || isValidExampleText(t.examples.place))
                  && (!('organizer' in t.examples) || isValidExampleText(t.examples.organizer))
                  && (!('address' in t.examples) || isValidExampleText(t.examples.address))
                  && (!('contact' in t.examples) || isValidExampleText(t.examples.contact))));
      }
      // Once a Super-Admin saved the header slogan it is locked for moderators.
      function sloganTouched() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['aboutSlogan1', 'aboutSlogan2']);
      }
      allow read: if true;
      allow create, update: if isAdminOrEmulatorAdmin() && isValidRegion(request.resource.data);
      // Regions-Moderator:innen maintain the "Über uns" page of their own
      // regions (header photo, text of the "Deine Heimat" section) and nothing else of the doc.
      allow update: if isRegionModeratorFor(regionId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['aboutHelperIds', 'aboutHeaderImage', 'aboutText', 'aboutSlogan1',
                                   'aboutSlogan2', 'texts', 'updatedAt'])
                    && (!sloganTouched() || resource.data.get('aboutSloganLocked', false) != true)
                    && isValidRegionFields(request.resource.data);
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // App-level settings — currently a single `theme` doc that holds the
    // admin-managed CSS color variables. Public read (clients need to
    // resolve the live values to paint `:root`), admin-only write. The
    // `updateVariable` and `resetAllToDefaults` actions write via a
    // merge with the keys that are actually changing, so we only need
    // to validate the union of all known fields plus `updatedAt` /
    // `updatedBy`. The canonical defaults land via `seedThemeIfMissing`
    // (anonymous write gated on `createdBy == 'system'`), mirroring the
    // categories bootstrap pattern.
    match /app_settings/{docId} {
      // `instagram` holds the automation kill switch: admin-only, unlike the
      // rest of this collection.
      allow read: if docId != 'instagram' || isAdminOrEmulatorAdmin();

      // Two create paths so an admin is never locked out if the system
      // seeder fails to run:
      //   1. Anonymous bootstrap gated on `createdBy == 'system'`.
      //   2. Admin write — same field whitelist as updates.
      allow create: if docId == 'theme'
                    && (
                      (request.auth == null
                        && request.resource.data.createdBy == 'system'
                        && request.resource.data.updatedBy == null
                        && request.resource.data.updatedAt != null
                        && request.resource.data.createdAt != null)
                      || (isAdminOrEmulatorAdmin()
                        && request.resource.data.keys().hasOnly([
                          'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                          '--bg-primary', '--bg-secondary', '--bg-calendar',
                          '--heading-color',
                          '--accent-secondary', '--accent-primary',
                          '--accent-primary-hover', '--accent-primary-strong',
                          '--accent-soft',
                          '--text-primary', '--text-secondary', '--text-light',
                          '--border', '--error', '--error-hover',
                          '--chip-bg', '--chip-text',
                          '--free-bg', '--free-text',
                          '--fee-bg', '--fee-text',
                          '--donation-bg', '--donation-text',
                          '--pending-bg', '--pending-text',
                          '--sound-healing', '--category-teal',
                        ]))
                    );

      // Admin write path — partial updates (merge) must include only
      // known token names plus the bookkeeping fields. `affectedKeys()`
      // gives us exactly the keys touched by this update.
      allow update: if docId == 'theme'
                    && isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                          '--bg-primary', '--bg-secondary', '--bg-calendar',
                          '--heading-color',
                          '--accent-secondary', '--accent-primary',
                          '--accent-primary-hover', '--accent-primary-strong',
                          '--accent-soft',
                          '--text-primary', '--text-secondary', '--text-light',
                          '--border', '--error', '--error-hover',
                          '--chip-bg', '--chip-text',
                          '--free-bg', '--free-text',
                          '--fee-bg', '--fee-text',
                          '--donation-bg', '--donation-text',
                          '--pending-bg', '--pending-text',
                          '--sound-healing', '--category-teal',
                        ]);

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Saved theme registry — admin-only CRUD. Each doc holds a named
    // snapshot of variable values plus bookkeeping metadata. Public read
    // so the admin UI can show theme names to non-admin viewers (e.g. a
    // read-only "currently active theme: X" indicator) without leaking
    // the concrete color values into the rules. The values themselves
    // are validated the same way as the live theme doc.
    match /themes/{themeId} {
      allow read: if true;

      function isValidThemeName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50;
      }

      function isValidThemeDescription(description) {
        return description == null
          || (description is string && description.size() <= 200);
      }

      function isValidThemeValues(values) {
        return values is map
          && values.keys().hasOnly([
            '--bg-primary', '--bg-secondary', '--bg-calendar',
            '--heading-color',
            '--accent-secondary', '--accent-primary',
            '--accent-primary-hover', '--accent-primary-strong',
            '--accent-soft',
            '--text-primary', '--text-secondary', '--text-light',
            '--border', '--error', '--error-hover',
            '--chip-bg', '--chip-text',
            '--free-bg', '--free-text',
            '--fee-bg', '--fee-text',
            '--donation-bg', '--donation-text',
            '--pending-bg', '--pending-text',
            '--sound-healing', '--category-teal',
          ])
          && values.keys().hasAll([
            '--bg-primary', '--bg-secondary', '--bg-calendar',
            '--heading-color',
            '--accent-secondary', '--accent-primary',
            '--accent-primary-hover', '--accent-primary-strong',
            '--accent-soft',
            '--text-primary', '--text-secondary', '--text-light',
            '--border', '--error', '--error-hover',
            '--chip-bg', '--chip-text',
            '--free-bg', '--free-text',
            '--fee-bg', '--fee-text',
            '--donation-bg', '--donation-text',
            '--pending-bg', '--pending-text',
            '--sound-healing', '--category-teal',
          ]);
      }

      allow create: if isAdminOrEmulatorAdmin()
                    && request.resource.data.keys().hasOnly([
                      'name', 'description', 'values',
                      'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                    ])
                    && isValidThemeName(request.resource.data.name)
                    && isValidThemeDescription(request.resource.data.description)
                    && isValidThemeValues(request.resource.data.values)
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'name', 'description', 'values',
                            'updatedAt', 'updatedBy',
                          ])
                    && (!('name' in request.resource.data)
                        || isValidThemeName(request.resource.data.name))
                    && (!('description' in request.resource.data)
                        || isValidThemeDescription(request.resource.data.description))
                    && (!('values' in request.resource.data)
                        || isValidThemeValues(request.resource.data.values));

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Instagram automation kill switch. Default OFF: a missing doc or
    // enabled != true means the Cloud Function does nothing. Admin only.
    //
    // The Cloud Functions token-refresh job also stores NON-SECRET metadata
    // here via the Admin SDK (tokenExpiresAt, tokenRefreshedAt,
    // tokenRefreshError). Clients may still only write the three fields
    // below: updates are checked on affectedKeys() so the server-owned
    // fields already in the doc do not block the admin toggle.
    match /app_settings/instagram {
      allow create: if isAdminOrEmulatorAdmin()
                    && request.resource.data.keys().hasOnly([
                      'enabled', 'updatedAt', 'updatedBy',
                    ])
                    && request.resource.data.enabled is bool;
      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'enabled', 'updatedAt', 'updatedBy',
                    ])
                    && request.resource.data.enabled is bool;
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Online status (opt-in, default off). Only a person who switched
    // "Online-Status anzeigen" on in the profile (publicProfile.showOnlineStatus)
    // may write a heartbeat; the browser sends one about once a minute while the
    // site is open and visible and deletes it on leaving. Viewers count docs
    // whose lastSeen is under two minutes old and only show the dot for people
    // whose profile has the opt-in. Readable by verified members only, so
    // logged-out visitors and throwaway accounts see nothing.
    //
    // Feature flag app_settings/onlineStatus { mode: 'off' | 'admins' | 'all' }.
    // A MISSING doc means 'admins' (test mode: only admins write and read presence);
    // 'all' opens it for everyone, 'off' closes it.
    match /app_settings/onlineStatus {
      allow create: if isChatStaff()
                    && request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow delete: if isChatStaff();
    }

    function onlineStatusMode() {
      return exists(/databases/$(database)/documents/app_settings/onlineStatus)
        ? get(/databases/$(database)/documents/app_settings/onlineStatus).data.get('mode', 'admins')
        : 'admins';
    }

    function onlineStatusOpen() {
      return onlineStatusMode() == 'all'
        || (onlineStatusMode() == 'admins' && isChatStaff());
    }

    match /presence/{uid} {
      function isValidBeat() {
        return request.auth.uid == uid
          && onlineStatusOpen()
          && request.resource.data.keys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time
          && get(/databases/$(database)/documents/users/$(uid)/publicProfile/data)
               .data.get('showOnlineStatus', false) == true;
      }

      allow read: if isAuthenticated()
                  && request.auth.token.email_verified == true
                  && onlineStatusOpen();
      allow create: if isValidBeat();
      allow update: if isValidBeat()
                    && request.time > resource.data.lastSeen + duration.value(20, 's');
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // ---- Community chat "Lagerfeuer" (docs/chat.md) -----------------------
    // Feature flag: app_settings/chat { mode: 'off' | 'admins' | 'all' }.
    // A missing doc means off. app_settings is publicly readable, so the
    // header can decide whether to show the nav link.
    match /app_settings/chat {
      allow create: if isChatStaff()
                    && request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow delete: if isChatStaff();
    }

    // Like isAdminOrEmulatorAdmin(), but a missing `role` claim counts as
    // "no" instead of an evaluation error (which would also fail the rest
    // of an `||` chain for ordinary users).
    function isChatStaff() {
      return isAuthenticated()
        && (request.auth.token.get('role', null) == 'Admin' || isAdminViaFirestore());
    }

    function chatMode() {
      return exists(/databases/$(database)/documents/app_settings/chat)
        ? get(/databases/$(database)/documents/app_settings/chat).data.get('mode', 'off')
        : 'off';
    }

    // Login and a verified e-mail are mandatory; the flag decides who may
    // enter at all. Reads and writes are both gated, not only the UI.
    function chatAccessible() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (chatMode() == 'all' || (chatMode() == 'admins' && isChatStaff()));
    }

    function isChatBanned(uid) {
      return exists(/databases/$(database)/documents/chat_bans/$(uid))
        && get(/databases/$(database)/documents/chat_bans/$(uid)).data.until > request.time;
    }

    // Emoji reactions live on the message itself: `reactions: { uid: emoji }`,
    // one per person, so they are only ever readable together with the
    // message and vanish with it. An update may touch nothing but your own
    // entry. Keep the list in sync with src/utils/reactions.js.
    function isOwnReactionChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.get('reactions', {}) is map
        && request.resource.data.get('reactions', {})
             .diff(resource.data.get('reactions', {})).affectedKeys()
             .hasOnly([request.auth.uid]);
    }

    function isReactionRemoval() {
      return !(request.auth.uid in request.resource.data.get('reactions', {}));
    }

    function isValidReaction() {
      return request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '😮', '🙏'];
    }

    // Plain-text messages only. The author snapshot (name, photo) is copied
    // from the profile at send time. The text cannot be edited (only the
    // reactions change); the author or an admin deletes a message. A scheduled function purges them after 10
    // days (functions/src/chat.ts).
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read: if roomId == 'lagerfeuer' && chatAccessible();

      // The cooldown marker (members/{uid}) must be written in the same
      // batch with the same server time: that is what rate-limits senders.
      allow create: if roomId == 'lagerfeuer'
                    && chatAccessible()
                    && !isChatBanned(request.auth.uid)
                    && request.resource.data.keys().hasAll(['text', 'authorUid', 'authorName', 'createdAt'])
                    && request.resource.data.keys().hasOnly(
                      ['text', 'authorUid', 'authorName', 'authorPhotoURL', 'mentions', 'createdAt']
                    )
                    && (!('mentions' in request.resource.data)
                        || (request.resource.data.mentions is map
                            && request.resource.data.mentions.size() <= 10))
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    // Client limit is 500 characters; emoji count differently
                    // in rules, so this is only a generous hard ceiling.
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() >= 1
                    && request.resource.data.authorName.size() <= 80
                    && (!('authorPhotoURL' in request.resource.data)
                        || request.resource.data.authorPhotoURL == null
                        || (request.resource.data.authorPhotoURL is string
                            && request.resource.data.authorPhotoURL.size() <= 1000
                            && request.resource.data.authorPhotoURL.matches(
                              '^(https://(firebasestorage\\.googleapis\\.com|[a-z0-9-]+\\.googleusercontent\\.com)|http://(127\\.0\\.0\\.1|localhost):[0-9]+)/.*'
                            )))
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/chat_rooms/$(roomId)/members/$(request.auth.uid))
                         .data.lastMessageAt == request.time;

      // Reacting needs the same access as sending (also no mute/ban). Taking
      // your own reaction back is always allowed (account deletion does it).
      allow update: if roomId == 'lagerfeuer'
                    && isAuthenticated()
                    && isOwnReactionChange()
                    && (isReactionRemoval()
                        || (chatAccessible()
                            && !isChatBanned(request.auth.uid)
                            && isValidReaction()));

      // Own messages stay deletable even when the chat is switched off or
      // the author is banned (account deletion removes them too).
      allow delete: if roomId == 'lagerfeuer'
                    && isAuthenticated()
                    && (resource.data.authorUid == request.auth.uid || isChatStaff());
    }

    // Cooldown marker: one doc per sender holding the time of the last message.
    match /chat_rooms/{roomId}/members/{uid} {
      allow create: if roomId == 'lagerfeuer'
                    && chatAccessible()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['lastMessageAt'])
                    && request.resource.data.lastMessageAt == request.time;

      allow update: if roomId == 'lagerfeuer'
                    && chatAccessible()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['lastMessageAt'])
                    && request.resource.data.lastMessageAt == request.time
                    && request.time > resource.data.lastMessageAt + duration.value(3, 's');

      allow delete: if roomId == 'lagerfeuer'
                    && isAuthenticated()
                    && request.auth.uid == uid;
    }

    // ---- "Kerzenraum": one small chat room per event (docs/chat.md) ---------
    // Same flag as the Lagerfeuer. Reading needs no login (mode 'all': everyone,
    // 'admins': admins only); writing needs the same as the Lagerfeuer
    // (login, verified e-mail, not muted/banned). Only approved events get a room.
    function candleRoomReadable() {
      return chatMode() == 'all' || (chatMode() == 'admins' && isChatStaff());
    }

    // event_chats/{eventId} is the room summary the calendar listens to:
    // { lastMessageAt, lastMessageId }. It is only written together with a new
    // message (same batch, same server time), so nobody can light the candle
    // without writing a real message.
    match /event_chats/{eventId} {
      // Harmless (two fields); signed-in users may read it so account deletion
      // finds their rooms even while the flag is off.
      allow read: if candleRoomReadable() || isAuthenticated();

      allow create, update: if chatAccessible()
                            && !isChatBanned(request.auth.uid)
                            && request.resource.data.keys().hasOnly(['lastMessageAt', 'lastMessageId'])
                            && request.resource.data.lastMessageAt == request.time
                            && request.resource.data.lastMessageId is string
                            && getAfter(/databases/$(database)/documents/event_chats/$(eventId)/messages/$(request.resource.data.lastMessageId))
                                 .data.createdAt == request.time
                            && getAfter(/databases/$(database)/documents/event_chats/$(eventId)/messages/$(request.resource.data.lastMessageId))
                                 .data.authorUid == request.auth.uid;

      allow delete: if isChatStaff();

      match /messages/{messageId} {
        // Own messages stay findable for account deletion even when the room is closed.
        allow read: if candleRoomReadable()
                    || (isAuthenticated() && resource.data.authorUid == request.auth.uid);

        allow create: if chatAccessible()
                      && !isChatBanned(request.auth.uid)
                      && exists(/databases/$(database)/documents/events/$(eventId))
                      && get(/databases/$(database)/documents/events/$(eventId)).data.get('status', '') == 'approved'
                      && request.resource.data.keys().hasAll(['text', 'authorUid', 'authorName', 'createdAt'])
                      && request.resource.data.keys().hasOnly(
                        ['text', 'authorUid', 'authorName', 'authorPhotoURL', 'mentions', 'createdAt']
                      )
                      && (!('mentions' in request.resource.data)
                          || (request.resource.data.mentions is map
                              && request.resource.data.mentions.size() <= 10))
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() >= 1
                      && request.resource.data.authorName.size() <= 80
                      && (!('authorPhotoURL' in request.resource.data)
                          || request.resource.data.authorPhotoURL == null
                          || (request.resource.data.authorPhotoURL is string
                              && request.resource.data.authorPhotoURL.size() <= 1000
                              && request.resource.data.authorPhotoURL.matches(
                                '^(https://(firebasestorage\\.googleapis\\.com|[a-z0-9-]+\\.googleusercontent\\.com)|http://(127\\.0\\.0\\.1|localhost):[0-9]+)/.*'
                              )))
                      && request.resource.data.createdAt == request.time
                      && getAfter(/databases/$(database)/documents/event_chats/$(eventId)/members/$(request.auth.uid))
                           .data.lastMessageAt == request.time
                      && getAfter(/databases/$(database)/documents/event_chats/$(eventId))
                           .data.lastMessageId == messageId;

        // Reactions work like in the Lagerfeuer: only your own map entry may
        // change; setting one needs chat access and no mute/ban, taking it
        // back is always allowed (account deletion does it).
        allow update: if isAuthenticated()
                      && isOwnReactionChange()
                      && (isReactionRemoval()
                          || (chatAccessible()
                              && !isChatBanned(request.auth.uid)
                              && isValidReaction()));

        allow delete: if isAuthenticated()
                      && (resource.data.authorUid == request.auth.uid || isChatStaff());
      }

      // Cooldown marker per sender, 3 s like the Lagerfeuer.
      match /members/{uid} {
        allow create: if chatAccessible()
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['lastMessageAt'])
                      && request.resource.data.lastMessageAt == request.time;

        allow update: if chatAccessible()
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['lastMessageAt'])
                      && request.resource.data.lastMessageAt == request.time
                      && request.time > resource.data.lastMessageAt + duration.value(3, 's');

        allow delete: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    // Feature flag for the profile onboarding wizard:
    // app_settings/onboarding { mode: 'off' | 'admins' | 'all' }. A missing doc
    // means off.
    match /app_settings/onboarding {
      allow create: if isChatStaff()
                    && request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow delete: if isChatStaff();
    }

    // ---- Private messenger "Postfach" (docs/messenger.md) -------------------
    // Feature flag: app_settings/messenger { mode: 'off' | 'admins' | 'all' },
    // same semantics as the chat flag. A missing doc means off.
    match /app_settings/messenger {
      allow create: if isChatStaff()
                    && request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['mode', 'updatedAt', 'updatedBy'])
                    && request.resource.data.mode in ['off', 'admins', 'all'];
      allow delete: if isChatStaff();
    }

    function messengerMode() {
      return exists(/databases/$(database)/documents/app_settings/messenger)
        ? get(/databases/$(database)/documents/app_settings/messenger).data.get('mode', 'off')
        : 'off';
    }

    function messengerAccessible() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && (messengerMode() == 'all' || (messengerMode() == 'admins' && isChatStaff()));
    }

    // Admins can NOT read private messages (no isChatStaff() on reads). They
    // only see what a participant reports (dm_reports). A thread is 1:1 and its
    // id is the two uids, sorted and joined by "_", so membership can be read
    // off the id without a get().
    match /dm_threads/{threadId} {
      function isDmMember() {
        return request.auth.uid in threadId.split('_');
      }

      allow get: if messengerAccessible() && isDmMember();
      allow list: if messengerAccessible() && request.auth.uid in resource.data.participants;

      // The first message creates the thread. Starting threads is limited by
      // dm_starters (written in the same batch).
      allow create: if messengerAccessible()
                    && !isChatBanned(request.auth.uid)
                    && request.resource.data.keys().hasOnly(
                      ['participants', 'lastMessageText', 'lastMessageAt', 'lastMessageBy',
                       'readAt', 'createdAt']
                    )
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants[0] < request.resource.data.participants[1]
                    && threadId == request.resource.data.participants[0] + '_'
                                   + request.resource.data.participants[1]
                    && request.resource.data.lastMessageBy == request.auth.uid
                    && request.resource.data.lastMessageAt == request.time
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastMessageText is string
                    && request.resource.data.lastMessageText.size() <= 140
                    && request.resource.data.readAt is map
                    && request.resource.data.readAt.keys().hasOnly([request.auth.uid])
                    && getAfter(/databases/$(database)/documents/dm_starters/$(request.auth.uid))
                         .data.lastThreadAt == request.time;

      // A new message updates the summary in the same batch (2 s cooldown per sender).
      allow update: if messengerAccessible()
                    && isDmMember()
                    && !isChatBanned(request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageBy'])
                    && request.resource.data.lastMessageBy == request.auth.uid
                    && request.resource.data.lastMessageAt == request.time
                    && request.resource.data.lastMessageText is string
                    && request.resource.data.lastMessageText.size() <= 140
                    // The cooldown applies to the same sender writing again; an answer
                    // right after the other person's message is fine.
                    && (resource.data.lastMessageBy != request.auth.uid
                        || request.time > resource.data.lastMessageAt + duration.value(2, 's'));

      // Opening a conversation marks it read: only your own entry of readAt.
      allow update: if messengerAccessible()
                    && isDmMember()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
                    && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys()
                        .hasOnly([request.auth.uid])
                    && request.resource.data.readAt[request.auth.uid] == request.time;

      match /messages/{messageId} {
        function dmOther() {
          return threadId.split('_')[0] == request.auth.uid
            ? threadId.split('_')[1]
            : threadId.split('_')[0];
        }

        allow read: if messengerAccessible() && request.auth.uid in threadId.split('_');

        allow create: if messengerAccessible()
                      && request.auth.uid in threadId.split('_')
                      && !isChatBanned(request.auth.uid)
                      && request.resource.data.keys().hasOnly(['text', 'authorUid', 'createdAt'])
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.createdAt == request.time
                      && getAfter(/databases/$(database)/documents/dm_threads/$(threadId))
                           .data.lastMessageAt == request.time
                      && getAfter(/databases/$(database)/documents/dm_threads/$(threadId))
                           .data.lastMessageBy == request.auth.uid
                      // Not blocked by the recipient, and the recipient takes messages.
                      && !exists(/databases/$(database)/documents/dm_blocks/$(dmOther() + '_' + request.auth.uid))
                      && !(exists(/databases/$(database)/documents/dm_settings/$(dmOther()))
                           && get(/databases/$(database)/documents/dm_settings/$(dmOther()))
                                .data.get('allowDirectMessages', true) == false);

        // Reactions: only the two participants (admins can NOT, as with reading),
        // with the same gates as sending. Taking your own back is always allowed.
        allow update: if isAuthenticated()
                      && request.auth.uid in threadId.split('_')
                      && isOwnReactionChange()
                      && (isReactionRemoval()
                          || (messengerAccessible()
                              && !isChatBanned(request.auth.uid)
                              && isValidReaction()
                              && !exists(/databases/$(database)/documents/dm_blocks/$(dmOther() + '_' + request.auth.uid))
                              && !(exists(/databases/$(database)/documents/dm_settings/$(dmOther()))
                                   && get(/databases/$(database)/documents/dm_settings/$(dmOther()))
                                        .data.get('allowDirectMessages', true) == false)));

        // Your own messages stay deletable, also when the messenger is off.
        allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
      }
    }

    // Blocks: id is `${blocker}_${blocked}`. Only the blocker sees and manages them.
    match /dm_blocks/{blockId} {
      allow get, list: if isAuthenticated() && resource.data.blocker == request.auth.uid;
      allow create: if messengerAccessible()
                    && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'createdAt'])
                    && request.resource.data.blocker == request.auth.uid
                    && request.resource.data.blocked is string
                    && request.resource.data.blocked != request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blocked
                    && request.resource.data.createdAt == request.time;
      allow delete: if isAuthenticated() && resource.data.blocker == request.auth.uid;
    }

    // "Keine Privatnachrichten": readable by chat members so a card can say so.
    match /dm_settings/{uid} {
      allow read: if messengerAccessible();
      allow create, update: if messengerAccessible()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['allowDirectMessages', 'updatedAt'])
                            && request.resource.data.allowDirectMessages is bool;
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Limits starting new conversations: one per 20 s and 30 per day.
    match /dm_starters/{uid} {
      function startersDay() {
        return int(request.time.toMillis() / 86400000);
      }
      function isValidStarter() {
        return request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['lastThreadAt', 'day', 'count'])
          && request.resource.data.lastThreadAt == request.time
          && request.resource.data.day == startersDay();
      }

      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow create: if messengerAccessible()
                    && isValidStarter()
                    && request.resource.data.count == 1;
      allow update: if messengerAccessible()
                    && isValidStarter()
                    && request.time > resource.data.lastThreadAt + duration.value(20, 's')
                    && ((resource.data.day == request.resource.data.day
                         && request.resource.data.count == resource.data.count + 1
                         && request.resource.data.count <= 30)
                        || (resource.data.day != request.resource.data.day
                            && request.resource.data.count == 1));
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Reports of private messages: the reporter (a participant) copies the
    // last few messages in. The id is `${threadId}_${reporter}`.
    match /dm_reports/{reportId} {
      allow read: if isChatStaff();
      allow create: if messengerAccessible()
                    && request.resource.data.keys().hasOnly(
                      ['threadId', 'reportedBy', 'reportedUid', 'reportedName', 'excerpt',
                       'status', 'createdAt']
                    )
                    && request.resource.data.threadId is string
                    && request.auth.uid in request.resource.data.threadId.split('_')
                    && reportId == request.resource.data.threadId + '_' + request.auth.uid
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.reportedUid in request.resource.data.threadId.split('_')
                    && request.resource.data.reportedUid != request.auth.uid
                    && request.resource.data.reportedName is string
                    && request.resource.data.reportedName.size() <= 80
                    && request.resource.data.excerpt is string
                    && request.resource.data.excerpt.size() <= 3000
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
                    && request.resource.data.status in ['open', 'resolved'];
      allow delete: if isChatStaff();
    }

    // Presence ("who sits at the fire"): one heartbeat doc per person who has
    // the chat open. Written about once a minute while the tab is visible and
    // deleted on leaving; readers count docs whose lastSeen is under two
    // minutes old. The 20 s gap stops a client from flooding the listeners.
    match /chat_rooms/{roomId}/presence/{uid} {
      function isValidPresence() {
        return request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'lastSeen'])
          && request.resource.data.keys().hasAll(['displayName', 'lastSeen'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 80
          && (!('photoURL' in request.resource.data)
              || request.resource.data.photoURL == null
              || (request.resource.data.photoURL is string
                  && request.resource.data.photoURL.size() <= 1000
                  && request.resource.data.photoURL.matches(
                    '^(https://(firebasestorage\\.googleapis\\.com|[a-z0-9-]+\\.googleusercontent\\.com)|http://(127\\.0\\.0\\.1|localhost):[0-9]+)/.*'
                  )))
          && request.resource.data.lastSeen == request.time;
      }

      allow read: if roomId == 'lagerfeuer' && chatAccessible();

      allow create: if roomId == 'lagerfeuer'
                    && chatAccessible()
                    && request.auth.uid == uid
                    && isValidPresence();

      allow update: if roomId == 'lagerfeuer'
                    && chatAccessible()
                    && request.auth.uid == uid
                    && isValidPresence()
                    && request.time > resource.data.lastSeen + duration.value(20, 's');

      allow delete: if roomId == 'lagerfeuer'
                    && isAuthenticated()
                    && request.auth.uid == uid;
    }

    // Mutes and bans. `until` in the far future means permanent. Admins write;
    // the affected user may read their own entry to see why they cannot post.
    match /chat_bans/{uid} {
      allow read: if isChatStaff()
                  || (isAuthenticated() && request.auth.uid == uid);
      allow create, update: if isChatStaff()
                            && request.resource.data.keys().hasOnly(
                              ['until', 'reason', 'bannedBy', 'userName', 'createdAt']
                            )
                            && request.resource.data.until is timestamp
                            && request.resource.data.bannedBy == request.auth.uid
                            && request.resource.data.reason is string
                            && request.resource.data.reason.size() <= 200
                            && (!('userName' in request.resource.data)
                                || (request.resource.data.userName is string
                                    && request.resource.data.userName.size() <= 80));
      allow delete: if isChatStaff();
    }

    // Reports of messages. The id is `${messageId}_${reporterUid}`, so one
    // person reports a message only once. The text is copied into the report
    // because the message itself is purged after 10 days.
    match /chat_reports/{reportId} {
      allow read: if isChatStaff();
      allow create: if chatAccessible()
                    && request.resource.data.keys().hasOnly(
                      ['messageId', 'messageText', 'messageAuthorUid', 'messageAuthorName',
                       'reportedBy', 'status', 'createdAt', 'eventId']
                    )
                    // Optional: set for a message of an event's Kerzenraum, absent for the Lagerfeuer.
                    && (!('eventId' in request.resource.data)
                        || (request.resource.data.eventId is string
                            && request.resource.data.eventId.size() > 0
                            && request.resource.data.eventId.size() <= 128))
                    && request.resource.data.messageId is string
                    && request.resource.data.messageId.size() > 0
                    && request.resource.data.messageId.size() <= 40
                    && reportId == request.resource.data.messageId + '_' + request.auth.uid
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.messageText is string
                    && request.resource.data.messageText.size() <= 2000
                    && request.resource.data.messageAuthorUid is string
                    && request.resource.data.messageAuthorName is string
                    && request.resource.data.messageAuthorName.size() <= 80
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if isChatStaff()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'resolvedAt', 'resolvedBy'])
                    && request.resource.data.status in ['open', 'resolved'];
      allow delete: if isChatStaff();
    }

    // Refreshed Instagram access token (secret!). Written and read only by
    // the Cloud Functions (Admin SDK bypasses rules). No client may ever read
    // or write it, not even admins.
    match /instagram_private/{docId} {
      allow read, write: if false;
    }

    // Personal calendar feed tokens (secret!), doc id = uid. Issued, replaced
    // and deleted only by the getCalendarFeedToken callable and checked by
    // calendarFeed (Admin SDK bypasses rules). No client may read or write
    // them, not even the owner or admins: a readable token would open the
    // owner's calendar links to anyone.
    match /calendarFeedTokens/{uid} {
      allow read, write: if false;
    }

    // Idempotency/audit records of Instagram posts. Written only by the
    // Cloud Function (Admin SDK bypasses rules); admins may read them.
    match /instagram_posts/{postId} {
      allow read: if isAdminOrEmulatorAdmin();
      allow write: if false;
    }

    // Pointer doc that names which saved theme is currently active on the
    // website. Lives under `app_settings/` so it's grouped with the live
    // theme doc and so the existing public-read rule already covers it.
    // Admin-only writes; reads stay public so the admin UI can show
    // "Aktiv: …" labels without auth gymnastics.
    match /app_settings/activeTheme {
      allow read: if true;
      allow create, update: if isAdminOrEmulatorAdmin()
                            && request.resource.data.keys().hasOnly([
                              'themeId', 'name', 'activatedAt', 'activatedBy',
                            ])
                            && request.resource.data.themeId is string
                            && request.resource.data.themeId.size() > 0
                            && request.resource.data.themeId.size() <= 100
                            && (!('name' in request.resource.data)
                                || (request.resource.data.name is string
                                    && request.resource.data.name.size() <= 50))
                            && request.resource.data.activatedBy == request.auth.uid;
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Helpers (Mithelfer) registry — admin-managed list of people who
    // support the tribe. Public read so the "Über uns" page can render the
    // cards without auth gymnastics; admin-only CRUD. `profileSlug` links
    // to the public profile page (must start with `/` to discourage open
    // redirects when admins paste an arbitrary path), `website` is an
    // optional URL, `photoURL` an optional image, and `description` is
    // capped at 120 chars (matching the spec on the Trello ticket).
    match /helpers/{helperId} {
      allow read: if true;

      function isValidHelperName(name) {
        return name is string && name.size() >= 1 && name.size() <= 80;
      }
      function isValidHelperProfileSlug(slug) {
        return slug == null
          || (slug is string && slug.size() <= 120 && slug.matches('^/[A-Za-z0-9._/-]+$'));
      }
      function isValidHelperWebsite(website) {
        return website == null
          || (website is string && website.size() <= 300 && website.matches('^https?://.+$'));
      }
      // Firestore's `matches()` is RE2 and effectively anchored at both ends,
      // so `^https?://` alone only matches the literal strings "http://" or
      // "https://" — anything past the protocol (host, query, etc.) was
      // rejected with "Missing or insufficient permissions" when admins saved
      // a helper with a real URL. `.+$` requires at least one character
      // after the protocol so the value has to look like a URL, not just a
      // prefix.
      function isValidHelperPhotoUrl(url) {
        return url == null
          || (url is string && url.size() <= 500
              && (url.matches('^https?://.+$') || url.matches('^/[^/].*')));
      }
      function isValidHelperDescription(description) {
        return description == null
          || (description is string && description.size() <= 120);
      }

      allow create: if isAdminOrEmulatorAdmin()
                    && request.resource.data.keys().hasOnly([
                      'name', 'profileSlug', 'website', 'photoURL', 'description',
                      'order', 'createdAt', 'updatedAt', 'createdBy',
                    ])
                    && isValidHelperName(request.resource.data.name)
                    && isValidHelperProfileSlug(request.resource.data.profileSlug)
                    && isValidHelperWebsite(request.resource.data.website)
                    && isValidHelperPhotoUrl(request.resource.data.photoURL)
                    && isValidHelperDescription(request.resource.data.description);

      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'name', 'profileSlug', 'website', 'photoURL', 'description',
                            'order', 'updatedAt',
                          ])
                    && (!('name' in request.resource.data)
                        || isValidHelperName(request.resource.data.name))
                    && (!('profileSlug' in request.resource.data)
                        || isValidHelperProfileSlug(request.resource.data.profileSlug))
                    && (!('website' in request.resource.data)
                        || isValidHelperWebsite(request.resource.data.website))
                    && (!('photoURL' in request.resource.data)
                        || isValidHelperPhotoUrl(request.resource.data.photoURL))
                    && (!('description' in request.resource.data)
                        || isValidHelperDescription(request.resource.data.description));

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Donors registry — admin-managed list of previous donors for the
    // "Über uns" page. Public read so the list can render without auth;
    // admin-only CRUD. `name` may be null for anonymous donors,
    // `amount` may be null when the donor chose to hide it, and
    // `frequency` is informational (`one-time` | `monthly`) — donors who
    // pick "anonymous + amount shown" still appear by amount only.
    // Entries with `source == 'mollie'` are written by the Cloud Function
    // mollieWebhook via the Admin SDK (which bypasses these rules) after a
    // successful payment, then become visible/editable like any other entry.
    match /donors/{donorId} {
      allow read: if true;

      function isValidDonorName(name) {
        return name == null
          || (name is string && name.size() >= 1 && name.size() <= 80);
      }
      function isValidDonorAmount(amount) {
        return amount == null
          || (amount is number && amount >= 0 && amount <= 1000000);
      }
      function isValidDonorFrequency(frequency) {
        return frequency == null
          || (frequency is string && frequency in ['one-time', 'monthly']);
      }
      function isValidDonorNote(note) {
        return note == null
          || (note is string && note.size() <= 120);
      }
      function isValidDonorSource(source) {
        return source == null
          || (source is string && source in ['manual', 'mollie']);
      }
      function isValidDonorConsent(consent) {
        return consent == null || consent is bool;
      }
      function isValidMolliePaymentId(id) {
        return id == null
          || (id is string && id.size() > 0 && id.size() <= 80);
      }
      function isValidMollieSubscriptionId(id) {
        return id == null
          || (id is string && id.size() > 0 && id.size() <= 80);
      }

      allow create: if isAdminOrEmulatorAdmin()
                    && request.resource.data.keys().hasOnly([
                      'name', 'amount', 'frequency', 'note',
                      'order', 'createdAt', 'updatedAt', 'createdBy',
                      'source', 'mollieConsent',
                      'molliePaymentId', 'mollieSubscriptionId',
                    ])
                    && isValidDonorName(request.resource.data.name)
                    && isValidDonorAmount(request.resource.data.amount)
                    && isValidDonorFrequency(request.resource.data.frequency)
                    && isValidDonorNote(request.resource.data.note)
                    && (!('source' in request.resource.data)
                        || isValidDonorSource(request.resource.data.source))
                    && (!('mollieConsent' in request.resource.data)
                        || isValidDonorConsent(request.resource.data.mollieConsent))
                    && (!('molliePaymentId' in request.resource.data)
                        || isValidMolliePaymentId(request.resource.data.molliePaymentId))
                    && (!('mollieSubscriptionId' in request.resource.data)
                        || isValidMollieSubscriptionId(request.resource.data.mollieSubscriptionId));

      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'name', 'amount', 'frequency', 'note',
                            'order', 'updatedAt',
                          ])
                    && (!('name' in request.resource.data)
                        || isValidDonorName(request.resource.data.name))
                    && (!('amount' in request.resource.data)
                        || isValidDonorAmount(request.resource.data.amount))
                    && (!('frequency' in request.resource.data)
                        || isValidDonorFrequency(request.resource.data.frequency))
                    && (!('note' in request.resource.data)
                        || isValidDonorNote(request.resource.data.note));

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Feedback collection: anyone can submit anonymous feedback (with optional
    // name, email, and screenshot). Only admins can read / update / delete.
    match /feedback/{feedbackId} {
      allow read: if isAdminOrEmulatorAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                      ['description', 'name', 'email', 'screenshotUrl', 'screenshotFailed', 'pageUrl', 'pageTitle', 'userAgent', 'userId', 'status', 'createdAt']
                    )
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.status == 'new'
                    && (!('name' in request.resource.data) || request.resource.data.name == null || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
                    && (!('email' in request.resource.data) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
                    && (!('screenshotUrl' in request.resource.data) || request.resource.data.screenshotUrl == null || request.resource.data.screenshotUrl is string)
                    && (!('screenshotFailed' in request.resource.data) || request.resource.data.screenshotFailed == null || request.resource.data.screenshotFailed is bool)
                    && (!('pageUrl' in request.resource.data) || request.resource.data.pageUrl == null || (request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 500))
                    && (!('pageTitle' in request.resource.data) || request.resource.data.pageTitle == null || (request.resource.data.pageTitle is string && request.resource.data.pageTitle.size() <= 200))
                    && (!('userAgent' in request.resource.data) || request.resource.data.userAgent == null || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500))
                    && (!('userId' in request.resource.data) || request.resource.data.userId == null || request.resource.data.userId is string);

      allow update, delete: if isAdminOrEmulatorAdmin();
    }

    // Admin-defined groups of members (Mitgliedermanagement). Only admins can
    // read or write; the arrays hold user ids, no personal data.
    match /member_lists/{listId} {
      allow read, delete: if isAdminOrEmulatorAdmin();
      allow create, update: if isAdminOrEmulatorAdmin()
                            && request.resource.data.keys().hasOnly(['name', 'memberUids', 'createdAt', 'updatedAt'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.memberUids is list
                            && request.resource.data.memberUids.size() <= 5000;
    }
  }
}

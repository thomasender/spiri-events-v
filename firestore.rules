rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      function isAuthenticated() {
        return request.auth != null;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'Admin';
      }

      function isOwner() {
        return request.auth.uid == resource.data.createdBy;
      }

      function isApproved() {
        return resource.data.status == 'approved';
      }

      // Public read: approved events are readable by anyone
      allow read: if isApproved();

      // Authenticated users can read their own events (any status) and admins can read all
      allow read: if isAuthenticated() && (isAdmin() || isOwner());

      allow create: if isAuthenticated() && (request.resource.data.status == 'pending' || isAdmin());

      allow update, delete: if isAuthenticated() && (isOwner() || isAdmin());
    }
  }
}

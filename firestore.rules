rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    function isAdminViaFirestore() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isAdminOrEmulatorAdmin() {
      return isAdmin() || isAdminViaFirestore();
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isEventOwner(eventId) {
      return isAuthenticated()
        && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy;
    }

    function isApproved() {
      return resource.data.status == 'approved';
    }

    // Categories are managed by admins and shown on the public calendar.
    // `name` is normalized server-side (trim + 2–40 chars); `color` is a
    // 6-digit hex string. On create the id must match a deterministic slug
    // of the name so admins can't accidentally create duplicates.
    function isValidCategoryName(name) {
      return name is string && name.size() >= 2 && name.size() <= 40;
    }
    function isValidCategoryColor(color) {
      return color is string && color.matches('^#[0-9a-fA-F]{6}$');
    }
    function isValidCategoryOrder(order) {
      return order is int && order >= 0;
    }

    match /events/{eventId} {
      allow read: if isApproved() || isOwner() || isAdminOrEmulatorAdmin();

      // Anyone creating an event (including admins) must start it as
      // 'pending' or 'draft'. Approval happens via update. Non-admins
      // additionally need a confirmed email address.
      allow create: if (isAdminOrEmulatorAdmin()
                        || (isAuthenticated()
                            && request.auth.token.email_verified == true))
                    && request.resource.data.createdBy == request.auth.uid
                    && (request.resource.data.status in ['pending', 'draft'])
                    && request.resource.data.description.size() <= 20000
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 40));

      // Owners and admins can move events to/from the trash (status='trashed'),
      // and the first read rule already lets the owner + admin read trashed
      // events so the Papierkorb tab can list them.
      allow update: if (isOwner() || isAdminOrEmulatorAdmin())
                    && request.resource.data.description.size() <= 20000
                    && (request.resource.data.status in ['pending', 'draft', 'approved', 'trashed'])
                    && (!('category' in request.resource.data)
                        || (request.resource.data.category is string
                            && request.resource.data.category.size() <= 40));
      allow delete: if isOwner() || isAdminOrEmulatorAdmin();

      match /messages/{messageId} {
        allow read: if isEventOwner(eventId) || isAdminOrEmulatorAdmin();

        allow create: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin())
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(
                        ['text', 'authorUid', 'authorRole', 'authorName', 'createdAt', 'readByRecipient']
                      )
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.authorRole in ['Admin', 'User'];

        allow update: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin())
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readByRecipient']);

        // Owners can permanently delete their own event's messages via the
        // Papierkorb. Admins can always delete messages.
        allow delete: if isAdminOrEmulatorAdmin() || isEventOwner(eventId);
      }
    }

    match /admin_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                      ['displayName', 'bio', 'website', 'contact', 'photoURL', 'createdAt', 'updatedAt']
                    )
                    && request.resource.data.bio.size() <= 500
                    && request.resource.data.displayName.size() <= 80;

      allow update: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.bio.size() <= 500
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'bio', 'website', 'contact', 'photoURL', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Categories registry — admins manage name + color, the calendar reads
    // it publicly to render category chips. Only admins can update/delete.
    // On create there are two paths:
    //   1. Admin-authenticated write (normal CRUD via the admin UI).
    //   2. Anonymous "system seed" — locked to the canonical 7 initial
    //      category names so the app can self-bootstrap the registry on
    //      first run without requiring an admin to be signed in. The
    //      `createdBy == 'system'` flag + locked name list prevents abuse.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if (isAdminOrEmulatorAdmin()
                       && request.resource.data.keys().hasOnly(
                         ['name', 'color', 'order', 'createdAt', 'updatedAt', 'createdBy']
                       )
                       && isValidCategoryName(request.resource.data.name)
                       && isValidCategoryColor(request.resource.data.color)
                       && (!('order' in request.resource.data)
                           || isValidCategoryOrder(request.resource.data.order)))
                     || (request.auth == null
                         && request.resource.data.createdBy == 'system'
                         && request.resource.data.name in [
                           'Yoga',
                           'Breathwork',
                           'Meditation',
                           'Tanz',
                           'Singen',
                           'Soundhealing',
                           'Sonstiges',
                         ]
                         && request.resource.data.color is string
                         && isValidCategoryColor(request.resource.data.color));
      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['name', 'color', 'order', 'updatedAt'])
                    // Only validate the fields the admin actually changed —
                    // `request.resource.data` carries just the changed keys,
                    // not the merged document, so checking `name` on a
                    // reorder-only update would falsely fail.
                    && (!('name' in request.resource.data)
                        || isValidCategoryName(request.resource.data.name))
                    && (!('color' in request.resource.data)
                        || isValidCategoryColor(request.resource.data.color))
                    && (!('order' in request.resource.data)
                        || isValidCategoryOrder(request.resource.data.order));
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // App-level settings — currently a single `theme` doc that holds the
    // admin-managed CSS color variables. Public read (clients need to
    // resolve the live values to paint `:root`), admin-only write. The
    // `updateVariable` and `resetAllToDefaults` actions write via a
    // merge with the keys that are actually changing, so we only need
    // to validate the union of all known fields plus `updatedAt` /
    // `updatedBy`. The canonical defaults land via `seedThemeIfMissing`
    // (anonymous write gated on `createdBy == 'system'`), mirroring the
    // categories bootstrap pattern.
    match /app_settings/{docId} {
      allow read: if true;

      // Two create paths so an admin is never locked out if the system
      // seeder fails to run:
      //   1. Anonymous bootstrap gated on `createdBy == 'system'`.
      //   2. Admin write — same field whitelist as updates.
      allow create: if docId == 'theme'
                    && (
                      (request.auth == null
                        && request.resource.data.createdBy == 'system'
                        && request.resource.data.updatedBy == null
                        && request.resource.data.updatedAt != null
                        && request.resource.data.createdAt != null)
                      || (isAdminOrEmulatorAdmin()
                        && request.resource.data.keys().hasOnly([
                          'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                          '--bg-primary', '--bg-secondary', '--bg-calendar',
                          '--heading-color',
                          '--accent-secondary', '--accent-primary',
                          '--accent-primary-hover', '--accent-primary-strong',
                          '--accent-soft',
                          '--text-primary', '--text-secondary', '--text-light',
                          '--border', '--error', '--error-hover',
                          '--chip-bg', '--chip-text',
                          '--free-bg', '--free-text',
                          '--fee-bg', '--fee-text',
                          '--donation-bg', '--donation-text',
                          '--pending-bg', '--pending-text',
                          '--sound-healing', '--category-teal',
                        ]))
                    );

      // Admin write path — partial updates (merge) must include only
      // known token names plus the bookkeeping fields. `affectedKeys()`
      // gives us exactly the keys touched by this update.
      allow update: if docId == 'theme'
                    && isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                          '--bg-primary', '--bg-secondary', '--bg-calendar',
                          '--heading-color',
                          '--accent-secondary', '--accent-primary',
                          '--accent-primary-hover', '--accent-primary-strong',
                          '--accent-soft',
                          '--text-primary', '--text-secondary', '--text-light',
                          '--border', '--error', '--error-hover',
                          '--chip-bg', '--chip-text',
                          '--free-bg', '--free-text',
                          '--fee-bg', '--fee-text',
                          '--donation-bg', '--donation-text',
                          '--pending-bg', '--pending-text',
                          '--sound-healing', '--category-teal',
                        ]);

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Saved theme registry — admin-only CRUD. Each doc holds a named
    // snapshot of variable values plus bookkeeping metadata. Public read
    // so the admin UI can show theme names to non-admin viewers (e.g. a
    // read-only "currently active theme: X" indicator) without leaking
    // the concrete color values into the rules. The values themselves
    // are validated the same way as the live theme doc.
    match /themes/{themeId} {
      allow read: if true;

      function isValidThemeName(name) {
        return name is string && name.size() >= 1 && name.size() <= 50;
      }

      function isValidThemeDescription(description) {
        return description == null
          || (description is string && description.size() <= 200);
      }

      function isValidThemeValues(values) {
        return values is map
          && values.keys().hasOnly([
            '--bg-primary', '--bg-secondary', '--bg-calendar',
            '--heading-color',
            '--accent-secondary', '--accent-primary',
            '--accent-primary-hover', '--accent-primary-strong',
            '--accent-soft',
            '--text-primary', '--text-secondary', '--text-light',
            '--border', '--error', '--error-hover',
            '--chip-bg', '--chip-text',
            '--free-bg', '--free-text',
            '--fee-bg', '--fee-text',
            '--donation-bg', '--donation-text',
            '--pending-bg', '--pending-text',
            '--sound-healing', '--category-teal',
          ])
          && values.keys().hasAll([
            '--bg-primary', '--bg-secondary', '--bg-calendar',
            '--heading-color',
            '--accent-secondary', '--accent-primary',
            '--accent-primary-hover', '--accent-primary-strong',
            '--accent-soft',
            '--text-primary', '--text-secondary', '--text-light',
            '--border', '--error', '--error-hover',
            '--chip-bg', '--chip-text',
            '--free-bg', '--free-text',
            '--fee-bg', '--fee-text',
            '--donation-bg', '--donation-text',
            '--pending-bg', '--pending-text',
            '--sound-healing', '--category-teal',
          ]);
      }

      allow create: if isAdminOrEmulatorAdmin()
                    && request.resource.data.keys().hasOnly([
                      'name', 'description', 'values',
                      'createdBy', 'createdAt', 'updatedAt', 'updatedBy',
                    ])
                    && isValidThemeName(request.resource.data.name)
                    && isValidThemeDescription(request.resource.data.description)
                    && isValidThemeValues(request.resource.data.values)
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdminOrEmulatorAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'name', 'description', 'values',
                            'updatedAt', 'updatedBy',
                          ])
                    && (!('name' in request.resource.data)
                        || isValidThemeName(request.resource.data.name))
                    && (!('description' in request.resource.data)
                        || isValidThemeDescription(request.resource.data.description))
                    && (!('values' in request.resource.data)
                        || isValidThemeValues(request.resource.data.values));

      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Pointer doc that names which saved theme is currently active on the
    // website. Lives under `app_settings/` so it's grouped with the live
    // theme doc and so the existing public-read rule already covers it.
    // Admin-only writes; reads stay public so the admin UI can show
    // "Aktiv: …" labels without auth gymnastics.
    match /app_settings/activeTheme {
      allow read: if true;
      allow create, update: if isAdminOrEmulatorAdmin()
                            && request.resource.data.keys().hasOnly([
                              'themeId', 'name', 'activatedAt', 'activatedBy',
                            ])
                            && request.resource.data.themeId is string
                            && request.resource.data.themeId.size() > 0
                            && request.resource.data.themeId.size() <= 100
                            && (!('name' in request.resource.data)
                                || (request.resource.data.name is string
                                    && request.resource.data.name.size() <= 50))
                            && request.resource.data.activatedBy == request.auth.uid;
      allow delete: if isAdminOrEmulatorAdmin();
    }

    // Feedback collection: anyone can submit anonymous feedback (with optional
    // name, email, and screenshot). Only admins can read / update / delete.
    match /feedback/{feedbackId} {
      allow read: if isAdminOrEmulatorAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                      ['description', 'name', 'email', 'screenshotUrl', 'screenshotFailed', 'pageUrl', 'pageTitle', 'userAgent', 'userId', 'status', 'createdAt']
                    )
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 1000
                    && request.resource.data.status == 'new'
                    && (!('name' in request.resource.data) || request.resource.data.name == null || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
                    && (!('email' in request.resource.data) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
                    && (!('screenshotUrl' in request.resource.data) || request.resource.data.screenshotUrl == null || request.resource.data.screenshotUrl is string)
                    && (!('screenshotFailed' in request.resource.data) || request.resource.data.screenshotFailed == null || request.resource.data.screenshotFailed is bool)
                    && (!('pageUrl' in request.resource.data) || request.resource.data.pageUrl == null || (request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 500))
                    && (!('pageTitle' in request.resource.data) || request.resource.data.pageTitle == null || (request.resource.data.pageTitle is string && request.resource.data.pageTitle.size() <= 200))
                    && (!('userAgent' in request.resource.data) || request.resource.data.userAgent == null || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 500))
                    && (!('userId' in request.resource.data) || request.resource.data.userId == null || request.resource.data.userId is string);

      allow update, delete: if isAdminOrEmulatorAdmin();
    }
  }
}

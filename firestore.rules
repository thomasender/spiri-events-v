rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      function isAuthenticated() {
        return request.auth != null;
      }

      function isAdmin() {
        return request.auth != null && request.auth.token.role == 'Admin';
      }

      function isOwner() {
        return request.auth.uid == resource.data.createdBy;
      }

      function isApproved() {
        return resource.data.status == 'approved';
      }

      allow read: if isAuthenticated() && (isAdmin() || isOwner() || isApproved());

      allow create: if isAuthenticated() && (request.resource.data.status == 'pending' || isAdmin());

      allow update, delete: if isAuthenticated() && (isOwner() || isAdmin());
    }
  }
}

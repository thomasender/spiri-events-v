rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    function isAdminViaFirestore() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isAdminOrEmulatorAdmin() {
      return isAdmin() || isAdminViaFirestore();
    }

    function isOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }

    function isEventOwner(eventId) {
      return isAuthenticated()
        && request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy;
    }

    function isApproved() {
      return resource.data.status == 'approved';
    }

    match /events/{eventId} {
      allow read: if isApproved() || isOwner() || isAdminOrEmulatorAdmin();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && (request.resource.data.status in ['pending', 'draft'] || isAdminOrEmulatorAdmin());

      allow update, delete: if isOwner() || isAdminOrEmulatorAdmin();

      match /messages/{messageId} {
        allow read: if isEventOwner(eventId) || isAdminOrEmulatorAdmin();

        allow create: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin())
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(
                        ['text', 'authorUid', 'authorRole', 'authorName', 'createdAt', 'readByRecipient']
                      )
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.authorRole in ['Admin', 'User'];

        allow update: if (isEventOwner(eventId) || isAdminOrEmulatorAdmin())
                      && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readByRecipient']);

        allow delete: if isAdminOrEmulatorAdmin();
      }
    }

    match /admin_users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(
                      ['displayName', 'bio', 'website', 'contact', 'photoURL', 'createdAt', 'updatedAt']
                    )
                    && request.resource.data.bio.size() <= 500
                    && request.resource.data.displayName.size() <= 80;

      allow update: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.bio.size() <= 500
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'bio', 'website', 'contact', 'photoURL', 'updatedAt']);

      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }
  }
}
